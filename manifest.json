{
  "manifest_version": 3,
  "name": "PolyMakr",
  "version": "0.1.0",
  "description": "Monitore preços do Polymarket e configure regras de alerta e ordem limite.",
  "permissions": [
    "storage",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://polymarket.com/*",
    "https://*.polymarket.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir PolyMakr",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://polymarket.com/*",
        "https://*.polymarket.com/*"
      ],
      "js": [
        "scripts/content/rules.js",
        "scripts/content/polymarket.js",
        "scripts/content/execution.js",
        "scripts/content/views.js",
        "scripts/content/bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
